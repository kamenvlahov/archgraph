{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://archgraph.dev/schema/graph-model-v1.json",
  "title": "archgraph GraphModel v1",
  "type": "object",
  "required": ["version", "root", "nodes", "edges", "types"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1 },
    "root": { "$ref": "#/$defs/nonEmpty" },
    "nodes": { "type": "array", "items": { "$ref": "#/$defs/node" } },
    "edges": { "type": "array", "items": { "$ref": "#/$defs/edge" } },
    "types": { "type": "object", "additionalProperties": { "$ref": "#/$defs/typeShape" } }
  },
  "$defs": {
    "nonEmpty": { "type": "string", "minLength": 1 },
    "location": {
      "type": "object",
      "required": ["file", "line", "endLine"],
      "additionalProperties": false,
      "properties": {
        "file": { "$ref": "#/$defs/nonEmpty" },
        "line": { "type": "integer", "minimum": 1 },
        "endLine": { "type": "integer", "minimum": 1 }
      }
    },
    "node": {
      "type": "object",
      "required": ["id", "kind", "name", "language", "location", "members"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/nonEmpty" },
        "kind": { "enum": ["class", "interface", "trait", "enum", "function", "module", "route"] },
        "name": { "$ref": "#/$defs/nonEmpty" },
        "language": { "enum": ["php", "node", "python"] },
        "role": { "$ref": "#/$defs/nonEmpty" },
        "framework": { "$ref": "#/$defs/nonEmpty" },
        "location": { "$ref": "#/$defs/location" },
        "members": { "type": "array", "items": { "$ref": "#/$defs/member" } },
        "tags": { "type": "array", "items": { "type": "string" } }
      }
    },
    "member": {
      "type": "object",
      "required": ["name", "visibility", "inputs", "location"],
      "additionalProperties": false,
      "properties": {
        "name": { "$ref": "#/$defs/nonEmpty" },
        "visibility": { "enum": ["public", "protected", "private"] },
        "static": { "type": "boolean" },
        "async": { "type": "boolean" },
        "inputs": { "type": "array", "items": { "$ref": "#/$defs/port" } },
        "output": { "$ref": "#/$defs/port" },
        "throws": { "type": "array", "items": { "$ref": "#/$defs/typeRef" } },
        "location": { "$ref": "#/$defs/location" }
      }
    },
    "port": {
      "type": "object",
      "required": ["name", "type"],
      "additionalProperties": false,
      "properties": {
        "name": { "$ref": "#/$defs/nonEmpty" },
        "type": { "$ref": "#/$defs/typeRef" },
        "optional": { "type": "boolean" },
        "default": { "type": "string" },
        "variadic": { "type": "boolean" }
      }
    },
    "field": {
      "type": "object",
      "required": ["name", "type"],
      "additionalProperties": false,
      "properties": {
        "name": { "$ref": "#/$defs/nonEmpty" },
        "type": { "$ref": "#/$defs/typeRef" },
        "optional": { "type": "boolean" },
        "readonly": { "type": "boolean" }
      }
    },
    "typeShape": {
      "type": "object",
      "required": ["id", "name", "fields"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/nonEmpty" },
        "name": { "$ref": "#/$defs/nonEmpty" },
        "nodeId": { "$ref": "#/$defs/nonEmpty" },
        "fields": { "type": "array", "items": { "$ref": "#/$defs/field" } }
      }
    },
    "typeRef": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["named", "primitive", "array", "map", "union", "shape", "unknown"] }
      },
      "oneOf": [
        {
          "required": ["id"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "named" },
            "id": { "$ref": "#/$defs/nonEmpty" },
            "args": { "type": "array", "items": { "$ref": "#/$defs/typeRef" } }
          }
        },
        {
          "required": ["name"],
          "additionalProperties": false,
          "properties": { "kind": { "const": "primitive" }, "name": { "$ref": "#/$defs/nonEmpty" } }
        },
        {
          "required": ["of"],
          "additionalProperties": false,
          "properties": { "kind": { "const": "array" }, "of": { "$ref": "#/$defs/typeRef" } }
        },
        {
          "required": ["key", "value"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "map" },
            "key": { "$ref": "#/$defs/typeRef" },
            "value": { "$ref": "#/$defs/typeRef" }
          }
        },
        {
          "required": ["of"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "union" },
            "of": { "type": "array", "items": { "$ref": "#/$defs/typeRef" } }
          }
        },
        {
          "required": ["fields"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "shape" },
            "fields": { "type": "array", "items": { "$ref": "#/$defs/field" } }
          }
        },
        {
          "additionalProperties": false,
          "properties": { "kind": { "const": "unknown" }, "hint": { "$ref": "#/$defs/nonEmpty" } }
        }
      ]
    },
    "edgeEnd": {
      "type": "object",
      "required": ["node"],
      "additionalProperties": false,
      "properties": {
        "node": { "$ref": "#/$defs/nonEmpty" },
        "member": { "$ref": "#/$defs/nonEmpty" },
        "port": { "$ref": "#/$defs/nonEmpty" }
      }
    },
    "edge": {
      "type": "object",
      "required": ["id", "kind", "from", "to", "confidence"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/nonEmpty" },
        "kind": {
          "enum": ["implements", "extends", "injects", "calls", "creates", "routes-to", "returns", "uses-type"]
        },
        "from": { "$ref": "#/$defs/edgeEnd" },
        "to": { "$ref": "#/$defs/edgeEnd" },
        "confidence": { "enum": ["exact", "inferred"] }
      }
    }
  }
}
